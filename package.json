{
  "name": "matterlab-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "import:webflow": "node scripts/import-from-webflow.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "marked": "^18.2.0",
    "turndown": "^7.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
